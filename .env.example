# Copy this file to .env for Docker Compose. Use separate 64-character hex secrets.
# Hex avoids special-character parsing issues in DATABASE_URL.
POSTGRES_USER=churnuser
POSTGRES_PASSWORD=replace_with_64_hex_characters
POSTGRES_DB=churnxai
JWT_SECRET_KEY=replace_with_a_separate_64_character_hex_secret

# Local HTTP development uses non-Secure cookies. Set true behind HTTPS in production.
ENVIRONMENT=development
AUTH_COOKIE_SECURE=false
